# Example configuration; copy to `.env` (never committed) and fill in the values. Only
# `DATABASE_URL` is required; the README lists every variable with its default. Credentials are not
# set here: clients log in with the pairs `rivulet integration-credentials` stores.
DATABASE_URL=/var/lib/rivulet/rivulet.db
LISTEN_ADDR=0.0.0.0:8080
BASE_URL=https://reader.example.com
RUN_MIGRATIONS=1
POLLING_FREQUENCY=60
POLLING_PARSING_ERROR_LIMIT=3
LOG_LEVEL=info
LOG_FORMAT=text
FETCHER_ALLOW_PRIVATE_NETWORKS=0
