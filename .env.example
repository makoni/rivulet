# The names the runs read, one per line, as `docs/deploy.md` names them. Only `DATABASE_URL` is
# required; every other name reads as its default, and a name the config does not read answers
# nothing, so a typo here is not an error the run reports. That is what
# `Tools/deploy/deploy_check.py` reads against the sources, together with the document
# `Scripts/deploy.sh` leaves from the tool's own reading of this file.

# The values are placeholders the operator fills in. Nothing here is a credential: the file the run
# reads is `.env`, which is not committed, and the credential pair the clients log in with lands
# through `rivulet integration-credentials`, not through an environment name.
DATABASE_URL=/var/lib/rivulet/rivulet.db
LISTEN_ADDR=0.0.0.0:8080
BASE_URL=https://reader.example.com
RUN_MIGRATIONS=1
POLLING_FREQUENCY=60
POLLING_PARSING_ERROR_LIMIT=3
LOG_LEVEL=info
LOG_FORMAT=text
FETCHER_ALLOW_PRIVATE_NETWORKS=0
