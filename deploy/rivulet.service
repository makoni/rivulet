# Example systemd unit. `serve` handles SIGTERM (and SIGINT) for a clean shutdown with a WAL
# checkpoint. Adjust the binary path, and give the unit its configuration (for example with
# `EnvironmentFile=`), as `docs/deploy.md` describes.

[Unit]
Description=Rivulet serve run

[Service]
ExecStart=/rivulet serve
Restart=on-failure
KillSignal=SIGTERM
StateDirectory=rivulet

[Install]
WantedBy=multi-user.target
